{
  "private": true,
  "name": "lift-logic",
  "version": "0.13.5",
  "homepage": "https://vercel.com/grwyler/lift-logic/6dqx1URyU74n4gM9dLHkJgCaCRM2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "type-check": "tsc",
    "type-check:workout-safety": "tsc -p tsconfig.workout-safety.json",
    "test:unit": "vitest run",
    "test:fast": "npm run type-check && npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:android": "playwright test --project=android-chrome",
    "test:e2e:smoke": "playwright test smoke.spec.ts",
    "test:e2e:regression": "playwright test regression.spec.ts",
    "version:feature": "npm version minor --no-git-tag-version",
    "version:bugfix": "npm version patch --no-git-tag-version",
    "version:auto": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@mui/x-date-pickers": "^7.27.3",
    "@types/react-transition-group": "^4.4.12",
    "axios": "^1.8.2",
    "bootstrap": "^5.3.2",
    "date-fns": "^2.29.3",
    "gh-pages": "^6.1.1",
    "mongodb": "^6.3.0",
    "next": "15.2.8",
    "next-auth": "^4.24.5",
    "nodemailer": "^6.10.1",
    "openai": "^4.28.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.2",
    "react-datepicker": "^8.1.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-swipeable": "^7.0.1",
    "react-toastify": "^11.0.5",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^20.19.17",
    "@types/react": "17.0.73",
    "@types/react-dom": "^17.0.1",
    "typescript": "4.9.5",
    "vitest": "^0.34.6"
  }
}
