NEXT_PUBLIC_ENV=local
MONGODB_DB=LiftLogic
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
ORCHESTRATION_MONGODB_DB=orchestration
ORCHESTRATION_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
ORCHESTRATION_STORE_BACKEND=mongo
ORCHESTRATION_POSTGRES_URL=postgres://<username>:<password>@<host>:5432/<database>
ORCHESTRATION_ENABLE_SEED_DATA=true
ORCHESTRATION_PLATFORM_NAME=Signal Orchestrator
ORCHESTRATION_QUEUE_LABEL=Work Queue
NEXT_PUBLIC_ORCHESTRATION_PLATFORM_NAME=Signal Orchestrator
NEXT_PUBLIC_ORCHESTRATION_QUEUE_LABEL=Work Queue
NEXTAUTH_SECRET=<generate-a-long-random-secret>
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_RAPIDAPI_KEY=<rapidapi-key>
NEXT_PUBLIC_RAPIDAPI_HOST=exercisedb.p.rapidapi.com
OPENAI_API_KEY=<openai-api-key>
AI_GATEWAY_API_KEY=<vercel-ai-gateway-key>
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PRO_BETA_MONTHLY_PRICE_ID=<stripe-price-id-monthly>
STRIPE_PRO_BETA_YEARLY_PRICE_ID=<stripe-price-id-yearly>
NEXT_PUBLIC_STRIPE_PRO_BETA_MONTHLY_LABEL=$12 / month
NEXT_PUBLIC_STRIPE_PRO_BETA_YEARLY_LABEL=$79 / year
