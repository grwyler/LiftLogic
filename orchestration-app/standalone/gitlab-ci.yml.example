stages:
  - verify
  - container

default:
  image: node:24-bookworm
  cache:
    key: ${CI_COMMIT_REF_SLUG}
    paths:
      - node_modules/

install:
  stage: verify
  script:
    - npm ci

type_check:
  stage: verify
  script:
    - npm ci
    - npm run type-check

unit_tests:
  stage: verify
  script:
    - npm ci
    - npm run test:unit

build_app:
  stage: verify
  script:
    - npm ci
    - npm run build

schema_init_check:
  stage: verify
  script:
    - npm ci
    - node scripts/orchestration-init-postgres.mjs
  rules:
    - if: $ORCHESTRATION_POSTGRES_URL

docker_build:
  stage: container
  image: docker:27
  services:
    - docker:27-dind
  script:
    - docker build -f Dockerfile -t signal-orchestrator:${CI_COMMIT_SHA} .
