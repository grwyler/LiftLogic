{
  "name": "signal-orchestrator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "config:check": "node scripts/orchestration-check-config.mjs",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "db:init": "node scripts/orchestration-init-postgres.mjs",
    "verify": "npm run type-check && npm run test:unit && npm run build",
    "boot:check": "npm run config:check && npm run db:init && npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "mongodb": "^6.3.0",
    "next": "15.2.8",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "12.20.55",
    "@types/pg": "^8.18.0",
    "@types/react": "17.0.73",
    "@types/react-dom": "^17.0.1",
    "typescript": "4.9.5",
    "vitest": "^0.34.6"
  }
}
